<?icml using="@iclip/markup@1"?>
<icml>
  <import as="text" from="@iclip/text@1"/>
  <import as="media" from="@iclip/media@1"/>
  <import from="@iclip/script@1"/>
  <import as="film" from="@iclip/director@2"/>
  <import as="gpt" from="@iclip/gpt-image@1"/>
  <import as="seedance" from="@iclip/seedance@1"/>
  <import as="kit" source="@iclip/film-kits"/>

  <!-- 一、素材 -->
  <media:Image id="modelAPortraitPhoto" src="https://mmt-aigc-sz-public.oss-cn-shenzhen.aliyuncs.com/iclip/agent/uploads/d4c4ce47-9e3b-4cde-80ee-cf1062a43d6e.jpg"/>
  <media:Image id="modelAFullBodyPhoto" src="https://preview.invalid/uploads/modelAFullBodyPhoto.jpg"/>
  <media:Image id="shoeSidePhoto" src="https://mmt-aigc-sz-public.oss-cn-shenzhen.aliyuncs.com/iclip/agent/uploads/6383e34c-9c74-4ea4-b546-de95ba70789d.jpg"/>
  <media:Image id="shoeFrontPhoto" src="https://preview.invalid/uploads/shoeFrontPhoto.jpg"/>
  <media:Image id="shoeSolePhoto" src="https://preview.invalid/uploads/shoeSolePhoto.jpg"/>

  <!-- 二、全片设定 -->
  <text:Value id="videoCapture">
    摄影：手机拍摄，手持跟拍；景别以中景和脚部特写为主。
    剪辑：全片硬切，在迈步的动作点上剪。
    影调：清晨自然光，低对比，不做风格化调色。
  </text:Value>

  <script id="lines">
    <hook><模特A>这一双，走起来很轻。</hook>
    <reply><模特B>鞋底是软的吗？</reply>
    <answer><模特A>软，还回弹。</answer>
    <match><模特B>看着也挺百搭。</match>
    <stride><模特A>走一整天都不累。</stride>
    <daily><模特A>上班逛街都穿它。</daily>
    <close><模特A>穿上就知道了。</close>
  </script>

  <text:Value id="模特A声音">模特A：年轻女声，语气轻快，像随口跟朋友分享。</text:Value>
  <text:Value id="模特B声音">模特B：略低的女声，带点好奇。</text:Value>

  <text:Value id="配乐">纯音乐，三十三秒，轻快的城市流行节拍，适合鞋款种草短视频的背景音乐，混音干净</text:Value>

  <!-- 三、设定图 -->
  <text:Value id="capture">画面是用手机实拍的，真实自然，光线自然，没有过度美颜。</text:Value>

  <!-- personB：模特B 的设定图，没有照片，纯文字生图 -->
  <text:Value id="personBSubject">模特B，二十多岁的女性，黑色齐耳短发，穿米色风衣，神情轻松。</text:Value>
  <text:Value id="模特B身材">She has a well-proportioned figure, very broad shoulders and excellent head-to-shoulder proportions.</text:Value>
  <text:Value id="personBFraming">全身入画。她站在画面正中，脸正对镜头，双手自然下垂。</text:Value>
  <text:Value id="studioSetting">摄影棚。她身后是一面浅灰色的墙，脚下是同色的地面。</text:Value>
  <text:Render id="personBPrompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={personBSubject}/>
    <text:Append name="subject" text={模特B身材}/>
    <text:Set name="framing" text={personBFraming}/>
    <text:Set name="setting" text={studioSetting}/>
  </text:Render>
  <gpt:Image id="personB" prompt={personBPrompt} aspect-ratio="3:4" resolution="2k"/>

  <!-- scene：红砖街区的设定图，没有照片，纯文字生图 -->
  <text:Value id="sceneFraming">从人行道边平视过去，画面里没有人。</text:Value>
  <text:Value id="sceneSetting">纽约红砖街区，清晨的自然光。近处是干净的红砖人行道，路边有几棵行道树，远处是一排红砖公寓楼。</text:Value>
  <text:Render id="scenePrompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="framing" text={sceneFraming}/>
    <text:Set name="setting" text={sceneSetting}/>
  </text:Render>
  <gpt:Image id="scene" prompt={scenePrompt} aspect-ratio="16:9" resolution="2k"/>

  <!-- 四、第 1 组 video01：18 秒，三镜，两个人 -->

  <!-- view01：第 1 组镜头1 的机位图，这个场景的第一张 -->
  <text:Value id="view01Subject">模特A，长相和发型参考 @Image1，身材和服装参考 @Image2；模特B，长相、发型和服装参考 @Image3；模特A脚上穿着 SOLE_STRETCHY 鞋款，外观参考 @Image4（侧面）、@Image5（鞋头）。</text:Value>
  <text:Value id="view01Framing">中景，平视。两人站在人行道上、画面正中，并肩面朝镜头，模特A在左、模特B在右，双臂自然下垂。</text:Value>
  <text:Value id="view01Setting">纽约红砖街区参考 @Image6。</text:Value>
  <text:Render id="view01Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view01Subject}/>
    <text:Set name="framing" text={view01Framing}/>
    <text:Set name="setting" text={view01Setting}/>
  </text:Render>
  <gpt:Image id="view01" prompt={view01Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={modelAPortraitPhoto}/>
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={personB.image}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={shoeFrontPhoto}/>
    <gpt:Reference image={scene.image}/>
  </gpt:Image>

  <!-- view02：第 1 组镜头2 的机位图，与 view01 保持一致 -->
  <text:Value id="view02Subject">模特A的小腿和双脚，裤装参考 @Image1；她脚上的 SOLE_STRETCHY 鞋款，外观参考 @Image2（侧面）、@Image3（鞋底）。</text:Value>
  <text:Value id="view02Framing">侧面脚部特写，镜头与脚踝齐平，只拍到膝盖以下。她站在人行道上，脚尖朝向画面右侧，左脚在前、右脚在后，鞋底平踩在地上。</text:Value>
  <text:Value id="view02Setting">纽约红砖街区的人行道参考 @Image4，红砖墙和光线与 @Image5 保持一致。</text:Value>
  <text:Render id="view02Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view02Subject}/>
    <text:Set name="framing" text={view02Framing}/>
    <text:Set name="setting" text={view02Setting}/>
  </text:Render>
  <gpt:Image id="view02" prompt={view02Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={shoeSolePhoto}/>
    <gpt:Reference image={scene.image}/>
    <gpt:Reference image={view01.image}/>
  </gpt:Image>

  <!-- view03：第 1 组镜头3 的机位图，与 view01 保持一致 -->
  <text:Value id="view03Subject">模特B，长相、发型和服装参考 @Image1；模特A只拍到腰部以下，裤装参考 @Image2，脚上的 SOLE_STRETCHY 鞋款外观参考 @Image3（侧面）、@Image4（鞋头）。</text:Value>
  <text:Value id="view03Framing">近景，平视。模特B站在画面右侧，侧身低头看向画面左下方；模特A在画面左侧，只拍到腰部以下，右脚脚尖点地，鞋面朝向模特B。</text:Value>
  <text:Value id="view03Setting">纽约红砖街区参考 @Image5，红砖墙和光线与 @Image6 保持一致。</text:Value>
  <text:Render id="view03Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view03Subject}/>
    <text:Set name="framing" text={view03Framing}/>
    <text:Set name="setting" text={view03Setting}/>
  </text:Render>
  <gpt:Image id="view03" prompt={view03Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={personB.image}/>
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={shoeFrontPhoto}/>
    <gpt:Reference image={scene.image}/>
    <gpt:Reference image={view01.image}/>
  </gpt:Image>

  <!-- video01：本组的文字、镜头、提示词和视频节点 -->
  <text:Value id="video01ModelA">模特A，长相和发型参考 @Image1，身材和服装参考 @Image2。</text:Value>
  <text:Value id="video01ModelB">模特B，长相、发型和服装参考 @Image3。</text:Value>
  <text:Value id="video01Shoe">SOLE_STRETCHY 鞋款，外观参考 @Image4（侧面）、@Image5（鞋头）、@Image6（鞋底）。</text:Value>
  <text:Value id="video01Setting">纽约红砖街区参考 @Image7。</text:Value>
  <film:Shots id="video01Shots">
    <film:Shot start="0.0" end="6.0" view={view01.image}>参考@Image8，中景，平视，手持跟拍。模特A和模特B在红砖街区的人行道上并肩走向镜头。模特A低头看鞋说：{hook} 模特B侧头问：{reply} 音效：两人的脚步声与街道环境声。</film:Shot>
    <film:Shot start="6.0" end="12.0" view={view02.image}>参考@Image9，硬切，侧面脚部特写。模特A右脚向前迈出，鞋底落地时微微压扁再弹起，鞋底侧边清楚可见。她说：{answer} 音效：鞋底踩在人行道上的轻响。</film:Shot>
    <film:Shot start="12.0" end="18.0" view={view03.image}>参考@Image10，硬切，近景，平视。模特B低头看了看模特A的鞋，抬头对着镜头笑。她说：{match}</film:Shot>
  </film:Shots>
  <text:Render id="video01Prompt" template={kit.multi-shot-video-v1}>
    <text:Set name="capture" text={videoCapture}/>
    <text:Set name="person" text={video01ModelA}/>
    <text:Append name="person" text={video01ModelB}/>
    <text:Set name="product" text={video01Shoe}/>
    <text:Set name="setting" text={video01Setting}/>
    <text:Set name="audio" text={模特A声音}/>
    <text:Append name="audio" text={模特B声音}/>
    <text:Set name="shots" text={video01Shots}/>
  </text:Render>
  <seedance:ReferenceVideo id="video01" model="sd2.5" prompt={video01Prompt} duration="18" aspect-ratio="16:9">
    <seedance:Reference image={modelAPortraitPhoto}/>
    <seedance:Reference image={modelAFullBodyPhoto}/>
    <seedance:Reference image={personB.image}/>
    <seedance:Reference image={shoeSidePhoto}/>
    <seedance:Reference image={shoeFrontPhoto}/>
    <seedance:Reference image={shoeSolePhoto}/>
    <seedance:Reference image={scene.image}/>
    <seedance:Reference image={view01.image}/>
    <seedance:Reference image={view02.image}/>
    <seedance:Reference image={view03.image}/>
  </seedance:ReferenceVideo>

  <!-- 五、第 2 组 video02：15 秒，三镜，只有模特A -->

  <!-- view04：第 2 组镜头1 的机位图，与 view01 保持一致 -->
  <text:Value id="view04Subject">模特A的小腿和双脚，裤装参考 @Image1；她脚上的 SOLE_STRETCHY 鞋款，外观参考 @Image2（鞋头）、@Image3（侧面）。</text:Value>
  <text:Value id="view04Framing">低机位，正面脚部特写，只拍到膝盖以下。她站在人行道中间，面朝镜头，双脚并拢，鞋头朝向镜头。</text:Value>
  <text:Value id="view04Setting">纽约红砖街区的人行道参考 @Image4，红砖墙和光线与 @Image5 保持一致。</text:Value>
  <text:Render id="view04Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view04Subject}/>
    <text:Set name="framing" text={view04Framing}/>
    <text:Set name="setting" text={view04Setting}/>
  </text:Render>
  <gpt:Image id="view04" prompt={view04Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={shoeFrontPhoto}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={scene.image}/>
    <gpt:Reference image={view01.image}/>
  </gpt:Image>

  <!-- view05：第 2 组镜头2 的机位图，与 view01 保持一致 -->
  <text:Value id="view05Subject">模特A，身材、服装和发型参考 @Image1；她脚上的 SOLE_STRETCHY 鞋款，外观参考 @Image2（侧面）、@Image3（鞋底）。</text:Value>
  <text:Value id="view05Framing">中景，从她身后略偏右平视。她站在人行道转角处，背对镜头，右脚在前、脚跟微微抬起，画面左侧是红砖墙。</text:Value>
  <text:Value id="view05Setting">纽约红砖街区的人行道转角参考 @Image4，红砖墙和光线与 @Image5 保持一致。</text:Value>
  <text:Render id="view05Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view05Subject}/>
    <text:Set name="framing" text={view05Framing}/>
    <text:Set name="setting" text={view05Setting}/>
  </text:Render>
  <gpt:Image id="view05" prompt={view05Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={shoeSolePhoto}/>
    <gpt:Reference image={scene.image}/>
    <gpt:Reference image={view01.image}/>
  </gpt:Image>

  <!-- view06：第 2 组镜头3 的机位图，与 view01 保持一致 -->
  <text:Value id="view06Subject">模特A，长相和发型参考 @Image1，身材和服装参考 @Image2；她脚上的 SOLE_STRETCHY 鞋款，外观参考 @Image3（侧面）、@Image4（鞋头）。</text:Value>
  <text:Value id="view06Framing">全身入画，平视。她站在人行道上、画面正中，侧身朝向画面左侧，右脚在前，双手自然下垂。</text:Value>
  <text:Value id="view06Setting">纽约红砖街区参考 @Image5，红砖墙和光线与 @Image6 保持一致。</text:Value>
  <text:Render id="view06Prompt" template={kit.picture-v1}>
    <text:Set name="capture" text={capture}/>
    <text:Set name="subject" text={view06Subject}/>
    <text:Set name="framing" text={view06Framing}/>
    <text:Set name="setting" text={view06Setting}/>
  </text:Render>
  <gpt:Image id="view06" prompt={view06Prompt} aspect-ratio="16:9" resolution="2k">
    <gpt:Reference image={modelAPortraitPhoto}/>
    <gpt:Reference image={modelAFullBodyPhoto}/>
    <gpt:Reference image={shoeSidePhoto}/>
    <gpt:Reference image={shoeFrontPhoto}/>
    <gpt:Reference image={scene.image}/>
    <gpt:Reference image={view01.image}/>
  </gpt:Image>

  <!-- video02：本组的文字、镜头、提示词和视频节点 -->
  <text:Value id="video02ModelA">模特A，长相和发型参考 @Image1，身材和服装参考 @Image2。</text:Value>
  <text:Value id="video02Shoe">SOLE_STRETCHY 鞋款，外观参考 @Image3（侧面）、@Image4（鞋头）、@Image5（鞋底）。</text:Value>
  <text:Value id="video02Setting">纽约红砖街区参考 @Image6。</text:Value>
  <film:Shots id="video02Shots">
    <film:Shot start="0.0" end="5.0" view={view04.image}>参考@Image7，低机位，正面脚部特写。模特A朝镜头走来，右脚迈出，鞋底落地。她说：{stride} 音效：鞋底落地的一声轻响。</film:Shot>
    <film:Shot start="5.0" end="10.0" view={view05.image}>参考@Image8，硬切，中景，手持跟拍。模特A迈步走过街角，镜头跟在她身后，走了几步她回头看向镜头。她回头说：{daily} 音效：脚步声与街道环境声。</film:Shot>
    <film:Shot start="10.0" end="15.0" view={view06.image}>参考@Image9，硬切，全景，平视。模特A停下，转身面向镜头，鞋面朝向镜头。她笑着说：{close}</film:Shot>
  </film:Shots>
  <text:Render id="video02Prompt" template={kit.multi-shot-video-v1}>
    <text:Set name="capture" text={videoCapture}/>
    <text:Set name="person" text={video02ModelA}/>
    <text:Set name="product" text={video02Shoe}/>
    <text:Set name="setting" text={video02Setting}/>
    <text:Set name="audio" text={模特A声音}/>
    <text:Set name="shots" text={video02Shots}/>
  </text:Render>
  <seedance:ReferenceVideo id="video02" model="sd2.5" prompt={video02Prompt} duration="15" aspect-ratio="16:9">
    <seedance:Reference image={modelAPortraitPhoto}/>
    <seedance:Reference image={modelAFullBodyPhoto}/>
    <seedance:Reference image={shoeSidePhoto}/>
    <seedance:Reference image={shoeFrontPhoto}/>
    <seedance:Reference image={shoeSolePhoto}/>
    <seedance:Reference image={scene.image}/>
    <seedance:Reference image={view04.image}/>
    <seedance:Reference image={view05.image}/>
    <seedance:Reference image={view06.image}/>
  </seedance:ReferenceVideo>
</icml>
