"""本项目使用的 uharfbuzz 公共 C 扩展 API；上游 wheel 未附带类型声明。"""

from collections.abc import Sequence

class Face:
    def __init__(self, blob: bytes, index: int = 0) -> None: ...
    @property
    def upem(self) -> int: ...

class Font:
    def __init__(self, face: Face) -> None: ...
    @property
    def face(self) -> Face: ...

class GlyphPosition:
    @property
    def x_advance(self) -> int: ...

class GlyphInfo:
    @property
    def cluster(self) -> int: ...

class Buffer:
    def __init__(self) -> None: ...
    def add_str(self, text: str) -> None: ...
    def guess_segment_properties(self) -> None: ...
    @property
    def glyph_positions(self) -> Sequence[GlyphPosition]: ...
    @property
    def glyph_infos(self) -> Sequence[GlyphInfo]: ...

def shape(font: Font, buffer: Buffer) -> None: ...
