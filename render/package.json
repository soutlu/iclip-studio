{
  "name": "iclip-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "dev": "node scripts/build.mjs && node --enable-source-maps dist/main.js",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-catalog.mjs"
  },
  "dependencies": {
    "@hyperframes/engine": "0.8.168",
    "@hyperframes/producer": "0.8.168",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hyperframes/player": "0.8.168",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
