{
  "name": "producer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b && vite build",
    "ci:check": "pnpm format:check && pnpm lint && pnpm lint:design && pnpm lint:dead && pnpm contract:check && pnpm typecheck && pnpm test",
    "contract:check": "node scripts/check-openapi-contract.mjs",
    "contract:generate": "openapi-ts -f openapi-ts.config.js",
    "dev": "bash scripts/start-dev.sh",
    "dev:mock": "VITE_MODE=mock PORT=3014 bash scripts/start-dev.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:design": "node --test scripts/check-design-system.node-test.mjs && node scripts/check-design-system.mjs && node scripts/design-guard.mjs",
    "lint:dead": "knip",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "serve": "bash scripts/start-prod.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "verify": "pnpm ci:check && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-query-auth": "^2.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.0.2",
    "knip": "^6.32.3",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  }
}
