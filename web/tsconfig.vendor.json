{
  // 照抄来的外部合同（src/shared/transcript/vendor，见该目录的 README）。
  //
  // 它按上游自己的 tsconfig 写成，比本仓宽两格：`exactOptionalPropertyTypes` 与
  // `erasableSyntaxOnly`。放宽的只有这两项、只作用于这一个目录——本仓自己的代码仍走
  // tsconfig.app.json 的严格档。宽不了的那两项都不是安全性规则，改代码去迁就它们会让这份
  // 拷贝没法再跟上游对 diff，而「能对 diff」正是 vendor 的全部意义。
  //
  // 它是一个 composite 项目，只出类型声明（不出 JS，运行时由 Vite 直接读源码）。这样引用它
  // 的代码看到的是 .d.ts 而不是 .ts，于是上面那两格宽松**不会漏进**我们自己的代码里。
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vendor.tsbuildinfo",
    "exactOptionalPropertyTypes": false,
    "erasableSyntaxOnly": false,
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src/shared/transcript/vendor",
    "outDir": "./node_modules/.tmp/vendor-types"
  },
  "include": ["src/shared/transcript/vendor"],
  "exclude": ["src/shared/transcript/vendor/__tests__"]
}
