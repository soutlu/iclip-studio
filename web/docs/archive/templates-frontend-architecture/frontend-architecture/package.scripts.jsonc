// package.json 模板片段（scripts / 依赖）—— 合入项目 package.json
//
// 质量契约 = ci:check：本地与 CI 跑同一条命令（ARCHITECTURE.md §7）。
// lint/format 命令以 Biome 为例；ESLint 项目替换为等价命令即可，契约结构不变。
{
  "scripts": {
    // ── 质量契约（CI 的唯一入口；顺序：快 → 慢，先廉价失败）──
    "ci:check": "npm run lint && npm run typecheck && npm run arch:check && npm run test:unit",

    // ── 架构 ──
    // 日常/CI 校验：统一入口脚本自动适配基线生命周期
    //（基线文件存在 → 旧账不报新账即错；不存在 → 全量校验。清账后删基线文件即可）
    "arch:check": "node scripts/arch-check.mjs",
    // brownfield 接入或清账后重新冻结基线（基线文件进版本库，只许缩小）
    "arch:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    // 生成依赖图 SVG 供评审（需本机 graphviz：brew install graphviz）
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",

    // ── 质量 ──（Biome 示例；注意 includes 必须覆盖 tests/**）
    "lint": "biome lint ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "typecheck": "tsc --noEmit",

    // ── 测试 ──（vitest include 需含 tests/arch/**，见 vitest.config 模板）
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    // 服务端毒丸（BFF/全栈项目；纯 SPA 不需要）
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "dependency-cruiser": "^16"
  }
}
